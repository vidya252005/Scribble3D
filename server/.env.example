# Server port
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/scribble3d

# LLM API key - leave empty for now.
# When set, agent/llmClient.js will route intent-classification and
# parameter-extraction through the LLM instead of the rule-based fallback.
# Works with any OpenAI-compatible or Anthropic-compatible endpoint depending
# on LLM_PROVIDER below.
LLM_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
